# ===== ①ネタ管理（Supabase）=====
# 未設定の場合は data/terms.seed.json をローカル用語マスタとして使用する
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# テーブル名（既定: termcast_wood_terms / termcast_wood_assets）。間借り先に合わせて変更可。
SUPABASE_TERMS_TABLE=termcast_wood_terms
SUPABASE_ASSETS_TABLE=termcast_wood_assets

# ===== ②台本生成（Gemini Flash・無料枠）=====
# 設定すると「用語固有の濃い台本の自動生成」と「在庫が減ったときの用語の自動補充」が有効になる。
# 未設定なら台本は data/term-content.json（手書き）→汎用テンプレにフォールバックし、用語の自動補充は無効。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== 用語ネタの自動補充（npm run replenish / daily-run の先頭で実行）=====
# 未使用(pending)の在庫がこの数を下回ったら、Gemini が新しい木材用語を自動で足す。
WOOD_REPLENISH_THRESHOLD=8
WOOD_REPLENISH_TARGET=20

# ===== ③.5 実写素材アセット管理（木材版・README §3.5.1）=====
# 1 にすると「素材が1枚も無い用語は生成キューに乗せない」ガードを有効化する。
# 未設定（空）なら素材未整備でもプレースホルダで完走する。
WOOD_REQUIRE_ASSETS=

# ===== ④音声合成（VOICEVOX）=====
# ローカルエンジンの URL。到達できない場合は無音WAVモックにフォールバックする
VOICEVOX_URL=http://127.0.0.1:50021
# 木材版トーン（やわらかい・素朴）に合わせた既定話者。好みに応じて変更可。
VOICEVOX_SPEAKER=8
VOICEVOX_SPEED=1.0
# 各シーンの後ろに入れる無音の「間」（秒）。尺を20秒前後に伸ばしつつ間を作る。
SCENE_PAD_SEC=0.9

# ===== YouTube アップロード（YouTube Data API v3 / OAuth）=====
# ★木材版は YouTube アカウント（チャンネル）だけ株版と別物にする。
# 事前準備:
#   ① GCP で「YouTube Data API v3」を有効化
#   ② 木材チャンネル用の OAuth クライアントを YOUTUBE_CLIENT_SECRET_FILE に指定
#   ③ npm run youtube:auth を実行し、木材チャンネルで同意して refresh token を取得（下に保存）
# YOUTUBE_UPLOAD=1 かつ YOUTUBE_REFRESH_TOKEN があれば generate 時に自動アップロード。
YOUTUBE_UPLOAD=
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY_ID=27
YOUTUBE_REFRESH_TOKEN=
# OAuth クライアント(client_secret.json)のパス。未指定なら gws のものを流用。
YOUTUBE_CLIENT_SECRET_FILE=

# ===== ⑥配信: TikTok Content Posting API =====
TIKTOK_ACCESS_TOKEN=

# ===== Google Drive 保存（generate で自動保存 / Instagram用）=====
# 認証は gws CLI（keyring）が持つため、保存先フォルダID だけ設定すればよい。
# 設定すると generate の最後に自動で Drive へアップロードする。
GOOGLE_DRIVE_FOLDER_ID=
